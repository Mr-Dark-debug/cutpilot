{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CutPilot",
  "version": "1.0.1",
  "identifier": "com.mrdarkdebug.cutpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CutPilot",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Mr-Dark-debug",
    "copyright": "© 2026 Mr-Dark-debug",
    "category": "Video",
    "shortDescription": "AI video editor that writes the edit, you review it",
    "longDescription": "CutPilot edits talking-head, vlog and YouTube footage with your own Claude Code or Codex subscription and hands a finished timeline to DaVinci Resolve.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRDQyMEUwNzAzQzQyMjkKUldRcFFqeHc0Q0RVTXN6Nmt0eW9NaldCZnZsdDZCcm9xeU0xUVBpVCtMaFNLRHd3NFBZQ2lKWXkK",
      "endpoints": [
        "https://github.com/Mr-Dark-debug/cutpilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
